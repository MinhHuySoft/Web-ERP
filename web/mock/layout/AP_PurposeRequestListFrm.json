  {
   "tab": "1",
   "group": "",
   "name": "CommandButtonCtl",
   "cfg": "22;4;1;1;;;;;;;;;;;4;;;;;0;0",
   "props": {
    "C3": "Reload",
    "BT": "Gửi đề nghị",
    "BI": "email16",
    "BC": "-16711936",
    "C4": "UPDATE AP_PurchaseRequestTbl SET StatusID = 2, isLock = 1\r\nWHERE PurchaseRequestID = '{0}'\r\nSELECT N'Đã gửi đề nghị' as Msg",
    "P1": "PurchaseRequestID",
    "C1": "ExecSQL",
    "LBS": "SELECT ISNULL((SELECT CASE WHEN isLock = 1 THEN 1 WHEN StatusID = 1 OR StatusID = 4 THEN 0 ELSE 1 END FROM AP_PurchaseRequestTbl WHERE PurchaseRequestID = '{0}'), 1) AS isSend;",
    "LBSP": "PurchaseRequestID",
    "C2": "SaveContinue",
    "CS4": "select top 1 Msg, MsgType\r\nfrom (\r\n    select \r\n        1 as SortOrder,\r\n        N'Dữ liệu đã được cập nhật hoặc trạng thái đã thay đổi, vui lòng tải lại trang!' as Msg,\r\n        1 as MsgType\r\n    where exists (\r\n        select 1\r\n        from AP_PurchaseRequestTbl\r\n        where PurchaseRequestID = '{0}'\r\n        and StatusID in (2, 3)\r\n    )\r\n) A\r\norder by SortOrder;",
    "CS5": "PurchaseRequestID"
   }
  },
  {
   "tab": "1",
   "group": "",
   "name": "CommandButtonCtl_1",
   "cfg": "22;4;1;;;;;;;;;;;;;;;;;0;0",
   "props": {
    "C3": "Reload",
    "LBSP": "PurchaseRequestID",
    "BI": "arrow_right_blue",
    "BT": "Gửi đặt mua hàng",
    "BC": "-16711681",
    "C2": "SaveContinue",
    "C4": "INSERT INTO AP_OrderTbl (DocumentID, DocumentDate, Memo, Notes, ObjectID, CurrencyID, RateExchange, BranchID, isLock)\r\nSELECT PurchaseRequestID, PurchaseDate, Notes, PurposeDescOrClient, ObjectID, CurrencyID, RateExchange, BranchID, 0                      \r\nFROM AP_PurchaseRequestTbl\r\nWHERE PurchaseRequestID = '{0}';\r\n\r\nINSERT INTO AP_OrderDetailTbl (UserAutoID, DocumentID, ItemID, Quantity, UnitPrice, Notes)\r\nSELECT FORMAT(SYSDATETIME(), 'ddMMyyHHmmssfff') + \r\n    RIGHT('00000' + CAST(ABS(CHECKSUM(NEWID())) AS VARCHAR(10)), 5) + \r\n    RIGHT('00000' + CAST(ABS(CHECKSUM(NEWID())) AS VARCHAR(10)), 5) AS UserAutoID, \r\n    PurchaseRequestID, ItemID, Quantity, UnitPrice, TimeRequired           \r\nFROM AP_PurchaseRequestDetailTbl\r\nWHERE PurchaseRequestID = '{0}';\r\n\r\nUPDATE AP_PurchaseRequestTbl SET StatusID = 5 WHERE PurchaseRequestID = '{0}'\r\nSELECT N'Đã gửi đặt mua hàng' as Msg",
    "P1": "PurchaseRequestID",
    "LBS": "SELECT CASE WHEN StatusID <> 3 OR EXISTS (SELECT 1 FROM AP_OrderTbl WHERE DocumentID = '{0}') THEN 1  ELSE 0 END AS isSend FROM AP_PurchaseRequestTbl WHERE PurchaseRequestID = '{0}';",
    "CS4": "select top 1 Msg, MsgType\r\nfrom (\r\n    select \r\n        1 as SortOrder,\r\n        N'Dữ liệu đã được cập nhật hoặc trạng thái đã thay đổi, vui lòng tải lại trang!' as Msg,\r\n        1 as MsgType\r\n    where exists (\r\n        select 1\r\n        from AP_OrderTbl\r\n        where DocumentID = '{0}'\r\n    )\r\n\r\n    union all\r\n\r\n    select \r\n        2 as SortOrder,\r\n        N'Bạn cần gửi đề nghị và chờ đề nghị được duyệt trước khi gửi đặt mua hàng!' as Msg,\r\n        1 as MsgType\r\n    where exists (\r\n        select 1\r\n        from AP_PurchaseRequestTbl\r\n        where PurchaseRequestID = '{0}'\r\n        and StatusID = 4\r\n    )\r\n) A\r\norder by SortOrder;",
    "CS5": "PurchaseRequestID"
   }
  },
